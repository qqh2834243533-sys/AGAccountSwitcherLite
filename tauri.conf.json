{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AG Account Switcher Lite",
  "version": "0.2.0",
  "identifier": "org.ag-account-switcher.lite",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "AG Account Switcher Lite",
      "visible": false,
      "decorations": false,
      "shadow": false,
      "resizable": false,
      "maximizable": false,
      "width": 504,
      "height": 504
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "copyright": "Copyright (c) 2026 AG Account Switcher Lite contributors; derived from agy-switch (CC BY-NC-SA 4.0, NonCommercial)",
    "icon": ["icons/icon.ico"]
  }
}
