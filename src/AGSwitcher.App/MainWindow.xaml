<Window x:Class="AGSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AG Account Switcher Lite" Width="860" Height="660" MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#EDF2F4"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Language="zh-CN" UseLayoutRounding="True">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#162A3C" Padding="26,20">
                <Grid>
                    <StackPanel Margin="0,0,116,0">
                        <TextBlock Text="AG Account Switcher Lite" Foreground="White"
                                   FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 桌面账号切换演练" Foreground="#C8DBE4" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
                            Background="#C3F1DE" CornerRadius="5">
                        <TextBlock Text="纯模拟模式" Foreground="#17493A" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#E0EBED" Padding="26,12">
                <Grid>
                    <TextBlock Text="{Binding Message}" Margin="0,0,115,0"
                               AutomationProperties.AutomationId="OperationStatus"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding StateLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          IsEnabled="{Binding IsLocked}">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.22*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="候选账号" FontSize="20" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                     DisplayMemberPath="Label" AutomationProperties.AutomationId="AccountList"
                                     AutomationProperties.Name="候选模拟账号"
                                     Height="185" Margin="0,14,0,12" Padding="4"
                                     BorderBrush="{StaticResource Line}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,7" />
                                        <Setter Property="MinHeight" Value="36" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="添加" Command="{Binding AddCommand}"
                                        AutomationProperties.AutomationId="AddAccount" Margin="0,0,8,0" />
                                <Button Content="移除选中" Command="{Binding RemoveCommand}"
                                        AutomationProperties.AutomationId="RemoveAccount" />
                            </StackPanel>
                            <Button Content="准备模拟切换" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartCommand}" AutomationProperties.AutomationId="BeginSwitch"
                                    Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="当前模拟账号" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ActiveAccount}" FontSize="23" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ActiveAccount" Margin="0,4,0,14" />
                                <TextBlock Margin="0,0,0,16">
                                    <Run Text="模拟 Agent：" /><Run Text="{Binding TaskState, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="模拟场景" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Scenarios}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedScenario}"
                                          AutomationProperties.AutomationId="ScenarioList"
                                          AutomationProperties.Name="模拟场景" Margin="0,6,0,10" MinHeight="32" />
                                <Button Content="重置模拟" HorizontalAlignment="Left" Command="{Binding ResetCommand}"
                                        AutomationProperties.AutomationId="ResetSimulation" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="18,12">
                            <Expander Header="Antigravity 官方登录指引" AutomationProperties.AutomationId="LoginGuide">
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}">
                                    <Run Text="结束或确认 Agent 任务空闲后，在 Antigravity App 内退出。接着从 App 发起登录，在浏览器选择 Google 账号，回到 App 核对身份。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="本页仅提供步骤。请在官方 App 和浏览器中完成登录。" />
                                </TextBlock>
                            </Expander>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <Grid Background="#77162A3C" KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhenTrue}}">
            <Border Style="{StaticResource Panel}" Width="395" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="确认模拟切换" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedAccount.Label}" Margin="0,4,0,18" />
                    <TextBlock Text="输入下方的四位数字以防误触。" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Challenge}" FontFamily="Consolas" FontSize="34"
                               FontWeight="Bold" Foreground="{StaticResource Accent}"
                               AutomationProperties.AutomationId="Challenge" Margin="0,5,0,8" />
                    <TextBox x:Name="ConfirmationBox" Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="ConfirmationInput"
                             AutomationProperties.Name="四位模拟数字"
                             FontSize="20" MinHeight="37" MaxLength="4" Padding="8,4"
                             IsVisibleChanged="OnConfirmationVisibilityChanged" />
                    <TextBlock Text="{Binding ConfirmationError}" Foreground="#A52A20" MinHeight="20"
                               AutomationProperties.AutomationId="ConfirmationError" Margin="0,5,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="CancelSwitch" Margin="0,0,8,0" />
                        <Button Content="执行模拟" Command="{Binding ConfirmCommand}" IsDefault="True"
                                AutomationProperties.AutomationId="ConfirmSwitch" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
